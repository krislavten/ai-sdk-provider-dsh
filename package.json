{
  "name": "ai-sdk-provider-dsh",
  "version": "0.1.1",
  "description": "AI SDK provider that drives a DeepSeek Harness (dsh) runtime as a language model (LanguageModelV3 — works on both AI SDK v6 and v7)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-sdk",
    "deepseek",
    "dsh",
    "deepseek-harness",
    "agent",
    "provider",
    "vercel-ai-sdk"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.28.1",
  "files": [
    "dist",
    "runtime"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime/*": "./runtime/*"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src tests",
    "format": "biome check --write src tests",
    "prepublishOnly": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-spine-demo": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-subagent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-todo": "0.1.0-rc.6"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0 || ^4.0.0",
    "ai": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@ai-sdk/provider-utils": "^5.0.0",
    "@biomejs/biome": "^1.9.0",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "ai": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "@deepseek-ai/node-addon-landlock-run"
    ]
  }
}
